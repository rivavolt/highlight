{
  "manifest_version": 3,
  "name": "Text Highlighter",
  "version": "1.0",
  "description": "Highlight selected text with yellow color",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_title": "Text Highlighter"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "highlight@andreivolt",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "128.0"
    }
  }
}
